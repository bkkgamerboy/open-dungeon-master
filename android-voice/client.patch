@@ -2,9 +2,14 @@ package com.opendungeonmaster.app;
 
 import android.graphics.Color;
 import android.os.Bundle;
+import android.view.View;
+import android.view.ViewGroup;
 import androidx.activity.EdgeToEdge;
 import androidx.activity.SystemBarStyle;
+import androidx.core.graphics.Insets;
 import androidx.core.splashscreen.SplashScreen;
+import androidx.core.view.ViewCompat;
+import androidx.core.view.WindowInsetsCompat;
 import com.getcapacitor.BridgeActivity;
 
 public class MainActivity extends BridgeActivity {
@@ -34,5 +39,35 @@ public class MainActivity extends BridgeActivity {
         registerPlugin(SpeechPlugin.class);
         registerPlugin(SecretStorePlugin.class);
         super.onCreate(savedInstanceState);
+        keepAboveKeyboard();
+    }
+
+    // Capacitor's edge-to-edge margins (adjustMarginsForEdgeToEdge "force" in
+    // capacitor.config.ts) keep the page between the status bar and the
+    // navigation bar, but not above the keyboard: an app drawn edge to edge
+    // is no longer resized for it, so the keyboard covered the bottom of the
+    // page, and with it the box being typed in. This replaces Capacitor's
+    // listener, which the bridge installed during super.onCreate, with the
+    // same margins plus the keyboard: the bottom margin is the keyboard's
+    // height while it is up, the navigation bar's otherwise, and the page
+    // resizes into the space above it like a browser's would.
+    private void keepAboveKeyboard() {
+        if (getBridge() == null || getBridge().getWebView() == null) {
+            return;
+        }
+        View webView = getBridge().getWebView();
+        ViewCompat.setOnApplyWindowInsetsListener(webView, (view, windowInsets) -> {
+            Insets bars = windowInsets.getInsets(WindowInsetsCompat.Type.systemBars() | WindowInsetsCompat.Type.displayCutout());
+            Insets keyboard = windowInsets.getInsets(WindowInsetsCompat.Type.ime());
+            ViewGroup.MarginLayoutParams margins = (ViewGroup.MarginLayoutParams) view.getLayoutParams();
+            margins.leftMargin = bars.left;
+            margins.topMargin = bars.top;
+            margins.rightMargin = bars.right;
+            margins.bottomMargin = Math.max(bars.bottom, keyboard.bottom);
+            view.setLayoutParams(margins);
+            // As Capacitor's does: the page lays itself out inside the margins.
+            return WindowInsetsCompat.CONSUMED;
+        });
+        ViewCompat.requestApplyInsets(webView);
     }
 }
