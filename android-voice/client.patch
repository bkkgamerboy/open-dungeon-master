--- /dev/null
+++ b/mobile/tests/speech.test.ts
@@ -0,0 +1,148 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import {
+  createNativeSpeech,
+  installNativeSpeech,
+  MAX_CHUNK,
+  SPEECH_READY_EVENT,
+  speakOptions,
+  splitForSpeech,
+  voiceLabel,
+  type SpeechPlugin,
+} from "../src/speech-core";
+
+// The phone's voice as the table's narration sees it.
+
+function fakePlugin(options: { available?: boolean; finished?: boolean; fails?: string; voices?: unknown[] } = {}) {
+  const spoken: Array<Parameters<SpeechPlugin["speak"]>[0]> = [];
+  let stops = 0;
+  const plugin: SpeechPlugin = {
+    async available() {
+      return { available: options.available ?? true };
+    },
+    async speak(request) {
+      spoken.push(request);
+      if (options.fails) {
+        throw new Error(options.fails);
+      }
+      return { finished: options.finished ?? true };
+    },
+    async stop() {
+      stops += 1;
+    },
+    async voices() {
+      return { voices: (options.voices ?? []) as never };
+    },
+  };
+  return { plugin, spoken, stops: () => stops };
+}
+
+test("a short passage is one chunk, whitespace folded, paragraphs kept apart", () => {
+  assert.deepEqual(splitForSpeech("  The door   creaks.\n\n\nA voice:  \"Who goes there?\"  "), [
+    "The door creaks.\nA voice: \"Who goes there?\"",
+  ]);
+  assert.deepEqual(splitForSpeech("   \n\n  "), []);
+});
+
+test("a long passage splits at paragraphs, then sentences, then words, never past the limit", () => {
+  const paragraph = "The torches gutter. ".repeat(10).trim();
+  const chunks = splitForSpeech(`${paragraph}\n${paragraph}\n${paragraph}`, 250);
+  assert.ok(chunks.length >= 2);
+  for (const chunk of chunks) {
+    assert.ok(chunk.length <= 250, `chunk of ${chunk.length}`);
+    assert.ok(chunk.trim().length > 0);
+  }
+  // Nothing lost: the same words in the same order.
+  const words = (text: string) => text.split(/\s+/).filter(Boolean);
+  assert.deepEqual(words(chunks.join(" ")), words(`${paragraph} ${paragraph} ${paragraph}`));
+
+  const sentence = `${"word ".repeat(80).trim()}.`;
+  for (const chunk of splitForSpeech(sentence, 50)) {
+    assert.ok(chunk.length <= 50);
+  }
+  assert.deepEqual(splitForSpeech("x".repeat(120), 50), ["x".repeat(50), "x".repeat(50), "x".repeat(20)]);
+  assert.ok(splitForSpeech("A. ".repeat(5000)).every((chunk) => chunk.length <= MAX_CHUNK));
+});
+
+test("options the engine would refuse are clamped or dropped", () => {
+  assert.deepEqual(speakOptions({ voice: "  en-us-x-iob-local ", rate: 9, pitch: 0, volume: 1.5 }), {
+    voice: "en-us-x-iob-local",
+    rate: 4,
+    pitch: 0.25,
+    volume: 1,
+  });
+  assert.deepEqual(speakOptions({ voice: " ", rate: Number.NaN }), {});
+  assert.deepEqual(speakOptions(), {});
+});
+
+test("speak hands the engine the chunks and says how the take ended", async () => {
+  const done = fakePlugin();
+  const speech = createNativeSpeech(done.plugin);
+  assert.equal(await speech.speak("Roll for initiative.", { rate: 1.1, volume: 0.5 }), "done");
+  assert.deepEqual(done.spoken, [{ chunks: ["Roll for initiative."], rate: 1.1, volume: 0.5 }]);
+
+  const cut = fakePlugin({ finished: false });
+  assert.equal(await createNativeSpeech(cut.plugin).speak("A long tale."), "stopped");
+
+  const empty = fakePlugin();
+  assert.equal(await createNativeSpeech(empty.plugin).speak("   "), "done");
+  assert.equal(empty.spoken.length, 0, "nothing to say is not sent");
+});
+
+test("an engine failure reaches the page as a sentence", async () => {
+  const broken = fakePlugin({ fails: "This phone's voice is still downloading. Try again in a moment." });
+  await assert.rejects(createNativeSpeech(broken.plugin).speak("Hello."), /still downloading/);
+});
+
+test("stop never throws", async () => {
+  const fake = fakePlugin();
+  fake.plugin.stop = async () => {
+    throw new Error("gone");
+  };
+  await createNativeSpeech(fake.plugin).stop();
+});
+
+test("voices are named, deduplicated, offline first", async () => {
+  const fake = fakePlugin({
+    voices: [
+      { id: "en-gb-x-gbd-network", language: "en-GB", local: false },
+      { id: "en-us-x-iob-local", language: "en-US", local: true },
+      { id: "en-us-x-iob-local", language: "en-US", local: true },
+      { id: "", language: "en-US", local: true },
+    ],
+  });
+  const voices = await createNativeSpeech(fake.plugin).voices();
+  assert.deepEqual(
+    voices.map((voice) => voice.id),
+    ["en-us-x-iob-local", "en-gb-x-gbd-network"],
+  );
+  assert.match(voices[0].name, /iob$/);
+  assert.match(voices[1].name, /gbd \(online\)$/);
+  assert.equal(voiceLabel({ id: "Samsung Fiona", language: "en-GB", local: true }).endsWith("Samsung Fiona"), true);
+});
+
+test("the voice is offered only when the phone has an engine", async () => {
+  const events: string[] = [];
+  const target: { odmSpeech?: unknown; dispatchEvent(event: Event): boolean } = {
+    dispatchEvent(event: Event) {
+      events.push(event.type);
+      return true;
+    },
+  };
+  assert.equal(await installNativeSpeech(fakePlugin({ available: false }).plugin, target as never), false);
+  assert.equal(target.odmSpeech, undefined);
+  assert.deepEqual(events, []);
+
+  assert.equal(await installNativeSpeech(fakePlugin().plugin, target as never), true);
+  assert.equal(typeof (target.odmSpeech as { speak?: unknown }).speak, "function");
+  assert.deepEqual(events, [SPEECH_READY_EVENT]);
+});
+
+test("an engine that throws while asked is treated as absent", async () => {
+  const fake = fakePlugin();
+  fake.plugin.available = async () => {
+    throw new Error("no engine");
+  };
+  const target = { dispatchEvent: () => true } as { odmSpeech?: unknown; dispatchEvent(event: Event): boolean };
+  assert.equal(await installNativeSpeech(fake.plugin, target as never), false);
+});
