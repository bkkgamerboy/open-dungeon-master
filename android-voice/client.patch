@@ -0,0 +1,350 @@
+package com.opendungeonmaster.app;
+
+import android.media.AudioAttributes;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.speech.tts.TextToSpeech;
+import android.speech.tts.UtteranceProgressListener;
+import android.speech.tts.Voice;
+import com.getcapacitor.JSArray;
+import com.getcapacitor.JSObject;
+import com.getcapacitor.Plugin;
+import com.getcapacitor.PluginCall;
+import com.getcapacitor.PluginMethod;
+import com.getcapacitor.annotation.CapacitorPlugin;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import org.json.JSONException;
+
+/**
+ * The phone's own text-to-speech engine, for reading DM passages aloud when
+ * the server has no narration of its own (above all the world this phone
+ * hosts), or when the player would rather hear the phone. Free, offline
+ * with the engine's downloaded voices, and no audio file to fetch.
+ * mobile/src/speech-core.ts turns it into window.odmSpeech.
+ *
+ * available() -> { available }   waits for the engine to start
+ * speak({ chunks, voice?, rate?, pitch?, volume? }) -> { finished }
+ *     one take: the chunks in order. finished is false when stop() or a
+ *     newer take cut it short. Rejects when the engine fails.
+ * stop()
+ * voices() -> { voices: [{ id, language, local }] }
+ *
+ * Every piece of state lives on the main thread; the engine's progress
+ * callbacks arrive on a binder thread and are posted there.
+ */
+@CapacitorPlugin(name = "OdmSpeech")
+public class SpeechPlugin extends Plugin {
+
+    private static final int STARTING = 0;
+    private static final int READY = 1;
+    private static final int FAILED = -1;
+
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private TextToSpeech engine;
+    private int state = STARTING;
+    // available() calls that arrived while the engine was starting.
+    private final List<PluginCall> waiting = new ArrayList<>();
+    // The take being spoken: its call, the prefix every chunk's utterance id
+    // starts with, and the id of its last chunk.
+    private PluginCall speaking;
+    private String takePrefix = "";
+    private String lastChunk = "";
+    private int takes = 0;
+
+    @Override
+    public void load() {
+        main.post(this::startEngine);
+    }
+
+    private void startEngine() {
+        if (engine != null) {
+            return;
+        }
+        state = STARTING;
+        engine = new TextToSpeech(getContext(), status -> main.post(() -> engineStarted(status)));
+    }
+
+    private void engineStarted(int status) {
+        if (engine == null) {
+            return;
+        }
+        state = status == TextToSpeech.SUCCESS ? READY : FAILED;
+        if (state == READY) {
+            // Narration is media: it follows the media volume and ducks under
+            // a call, rather than riding the accessibility or alarm streams.
+            engine.setAudioAttributes(
+                new AudioAttributes.Builder()
+                    .setUsage(AudioAttributes.USAGE_MEDIA)
+                    .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
+                    .build()
+            );
+            engine.setOnUtteranceProgressListener(progress);
+        }
+        for (PluginCall call : waiting) {
+            answerAvailable(call);
+        }
+        waiting.clear();
+    }
+
+    private void answerAvailable(PluginCall call) {
+        JSObject result = new JSObject();
+        result.put("available", state == READY);
+        call.resolve(result);
+    }
+
+    @PluginMethod
+    public void available(PluginCall call) {
+        main.post(() -> {
+            if (engine == null) {
+                startEngine();
+            }
+            if (state == STARTING) {
+                waiting.add(call);
+            } else {
+                answerAvailable(call);
+            }
+        });
+    }
+
+    @PluginMethod
+    public void speak(PluginCall call) {
+        JSArray given = call.getArray("chunks");
+        List<String> chunks = new ArrayList<>();
+        try {
+            if (given != null) {
+                for (Object chunk : given.toList()) {
+                    String text = chunk == null ? "" : chunk.toString().trim();
+                    if (!text.isEmpty()) {
+                        chunks.add(text);
+                    }
+                }
+            }
+        } catch (JSONException error) {
+            call.reject("The passage could not be read.");
+            return;
+        }
+        String voice = call.getString("voice");
+        Float rate = call.getFloat("rate");
+        Float pitch = call.getFloat("pitch");
+        Float volume = call.getFloat("volume");
+        main.post(() -> begin(call, chunks, voice, rate, pitch, volume));
+    }
+
+    private void begin(PluginCall call, List<String> chunks, String voice, Float rate, Float pitch, Float volume) {
+        if (engine == null || state != READY) {
+            call.reject("This phone's text-to-speech is not ready.");
+            return;
+        }
+        // A newer take always wins: the one before it ends as stopped.
+        endTake(false);
+        if (chunks.isEmpty()) {
+            JSObject result = new JSObject();
+            result.put("finished", true);
+            call.resolve(result);
+            return;
+        }
+        chooseVoice(voice);
+        engine.setSpeechRate(rate == null ? 1f : rate);
+        engine.setPitch(pitch == null ? 1f : pitch);
+        Bundle params = new Bundle();
+        if (volume != null) {
+            params.putFloat(TextToSpeech.Engine.KEY_PARAM_VOLUME, Math.max(0f, Math.min(1f, volume)));
+        }
+        takes += 1;
+        String prefix = "odm-" + takes + "-";
+        speaking = call;
+        takePrefix = prefix;
+        lastChunk = prefix + (chunks.size() - 1);
+        for (int index = 0; index < chunks.size(); index += 1) {
+            int queued = engine.speak(
+                chunks.get(index),
+                index == 0 ? TextToSpeech.QUEUE_FLUSH : TextToSpeech.QUEUE_ADD,
+                params,
+                prefix + index
+            );
+            if (queued == TextToSpeech.ERROR) {
+                fail("This phone's voice refused the passage.");
+                return;
+            }
+        }
+    }
+
+    // The engine's default voice unless a voice it has (and has installed)
+    // was asked for.
+    private void chooseVoice(String name) {
+        Voice chosen = null;
+        if (name != null && !name.trim().isEmpty()) {
+            Set<Voice> voices = safeVoices();
+            for (Voice voice : voices) {
+                if (voice.getName().equals(name) && installed(voice)) {
+                    chosen = voice;
+                    break;
+                }
+            }
+        }
+        if (chosen == null) {
+            chosen = engine.getDefaultVoice();
+        }
+        if (chosen != null) {
+            engine.setVoice(chosen);
+        }
+    }
+
+    private Set<Voice> safeVoices() {
+        try {
+            Set<Voice> voices = engine == null ? null : engine.getVoices();
+            return voices == null ? java.util.Collections.emptySet() : voices;
+        } catch (RuntimeException error) {
+            // Some engines throw here while they update their voice data.
+            return java.util.Collections.emptySet();
+        }
+    }
+
+    private static boolean installed(Voice voice) {
+        Set<String> features = voice.getFeatures();
+        return features == null || !features.contains(TextToSpeech.Engine.KEY_FEATURE_NOT_INSTALLED);
+    }
+
+    @PluginMethod
+    public void stop(PluginCall call) {
+        main.post(() -> {
+            endTake(false);
+            if (engine != null) {
+                engine.stop();
+            }
+            call.resolve();
+        });
+    }
+
+    @PluginMethod
+    public void voices(PluginCall call) {
+        main.post(() -> {
+            JSArray list = new JSArray();
+            if (state == READY) {
+                for (Voice voice : safeVoices()) {
+                    if (!installed(voice)) {
+                        continue;
+                    }
+                    Locale locale = voice.getLocale();
+                    JSObject entry = new JSObject();
+                    entry.put("id", voice.getName());
+                    entry.put("language", locale == null ? "" : locale.toLanguageTag());
+                    entry.put("local", !voice.isNetworkConnectionRequired());
+                    list.put(entry);
+                }
+            }
+            JSObject result = new JSObject();
+            result.put("voices", list);
+            call.resolve(result);
+        });
+    }
+
+    // The take in progress, if any, is answered: spoken to the end or not.
+    private void endTake(boolean finished) {
+        PluginCall call = speaking;
+        speaking = null;
+        takePrefix = "";
+        lastChunk = "";
+        if (call != null) {
+            JSObject result = new JSObject();
+            result.put("finished", finished);
+            call.resolve(result);
+        }
+    }
+
+    private void fail(String message) {
+        PluginCall call = speaking;
+        speaking = null;
+        takePrefix = "";
+        lastChunk = "";
+        if (engine != null) {
+            engine.stop();
+        }
+        if (call != null) {
+            call.reject(message);
+        }
+    }
+
+    private boolean ofThisTake(String utteranceId) {
+        return speaking != null && utteranceId != null && !takePrefix.isEmpty() && utteranceId.startsWith(takePrefix);
+    }
+
+    private final UtteranceProgressListener progress = new UtteranceProgressListener() {
+        @Override
+        public void onStart(String utteranceId) {}
+
+        @Override
+        public void onDone(String utteranceId) {
+            main.post(() -> {
+                if (ofThisTake(utteranceId) && utteranceId.equals(lastChunk)) {
+                    endTake(true);
+                }
+            });
+        }
+
+        @Override
+        @SuppressWarnings("deprecation")
+        public void onError(String utteranceId) {
+            onError(utteranceId, TextToSpeech.ERROR);
+        }
+
+        @Override
+        public void onError(String utteranceId, int errorCode) {
+            main.post(() -> {
+                if (ofThisTake(utteranceId)) {
+                    fail(describe(errorCode));
+                }
+            });
+        }
+
+        // Flushed by a newer take or by stop(): only a take still in hand is
+        // answered, as stopped. The engine says this for the chunk playing and
+        // for each one still queued, and the first answer is the one kept.
+        @Override
+        public void onStop(String utteranceId, boolean interrupted) {
+            main.post(() -> {
+                if (ofThisTake(utteranceId)) {
+                    endTake(false);
+                }
+            });
+        }
+    };
+
+    private static String describe(int errorCode) {
+        switch (errorCode) {
+            case TextToSpeech.ERROR_NETWORK:
+            case TextToSpeech.ERROR_NETWORK_TIMEOUT:
+                return "This phone's voice needs the internet and could not reach it. Pick a voice that works offline in Settings.";
+            case TextToSpeech.ERROR_NOT_INSTALLED_YET:
+                return "This phone's voice is still downloading. Try again in a moment.";
+            case TextToSpeech.ERROR_OUTPUT:
+                return "This phone could not play its voice.";
+            default:
+                return "This phone's voice could not read that passage.";
+        }
+    }
+
+    @Override
+    protected void handleOnDestroy() {
+        main.post(() -> {
+            endTake(false);
+            for (PluginCall call : waiting) {
+                JSObject result = new JSObject();
+                result.put("available", false);
+                call.resolve(result);
+            }
+            waiting.clear();
+            if (engine != null) {
+                engine.stop();
+                engine.shutdown();
+                engine = null;
+            }
+            state = FAILED;
+        });
+        super.handleOnDestroy();
+    }
+}
