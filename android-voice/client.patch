index 0000000..6505efb
--- /dev/null
+++ b/mobile/src/speech-core.ts
@@ -0,0 +1,216 @@
+// The phone's own text-to-speech, offered to the game's screens as
+// window.odmSpeech (the contract lives in the server's
+// src/lib/native-speech.ts). The table reads DM passages with it when the
+// server it plays on has no narration of its own, which is the case for the
+// world this phone hosts unless an admin pays for a speech service, or when
+// the player asks for the phone's voice in Settings.
+//
+// Kept free of Capacitor so the tests can drive it with a fake plugin;
+// speech.ts wires the real one (android/.../SpeechPlugin.java).
+
+export interface SpeechPluginVoice {
+  id: string;
+  language: string;
+  local: boolean;
+}
+
+export interface SpeechPlugin {
+  available(): Promise<{ available: boolean }>;
+  // Speaks the chunks in order as one take. Resolves when the last one has
+  // been spoken (finished: true) or when stop() or a newer take cut it short
+  // (finished: false); rejects when the engine fails.
+  speak(options: { chunks: string[]; voice?: string; rate?: number; pitch?: number; volume?: number }): Promise<{ finished: boolean }>;
+  stop(): Promise<void>;
+  voices(): Promise<{ voices: SpeechPluginVoice[] }>;
+}
+
+// The shapes window.odmSpeech takes, repeated here so the shell does not
+// import server code.
+export interface NativeSpeechVoice {
+  id: string;
+  name: string;
+  language: string;
+  local: boolean;
+}
+
+export interface NativeSpeakOptions {
+  voice?: string;
+  rate?: number;
+  pitch?: number;
+  volume?: number;
+}
+
+export interface NativeSpeech {
+  speak(text: string, options?: NativeSpeakOptions): Promise<"done" | "stopped">;
+  stop(): Promise<void>;
+  voices(): Promise<NativeSpeechVoice[]>;
+}
+
+// The page listens for this to notice a voice that arrived after it drew
+// (NATIVE_SPEECH_EVENT in the server).
+export const SPEECH_READY_EVENT = "odm-speech";
+
+// Android's engines take at most TextToSpeech.getMaxSpeechInputLength()
+// characters per utterance, 4000 on every phone we know of; a long passage
+// is handed over in pieces well under that.
+export const MAX_CHUNK = 3000;
+
+function reason(error: unknown, fallback: string): string {
+  if (error && typeof error === "object" && "message" in error) {
+    const message = String((error as { message: unknown }).message ?? "");
+    if (message) {
+      return message;
+    }
+  }
+  return fallback;
+}
+
+// Pieces of at most `max` characters, joined back with `glue`.
+function pack(pieces: string[], max: number, glue: string, split: (piece: string) => string[]): string[] {
+  const out: string[] = [];
+  let current = "";
+  for (const piece of pieces) {
+    if (piece.length > max) {
+      if (current) {
+        out.push(current);
+        current = "";
+      }
+      out.push(...split(piece));
+      continue;
+    }
+    const joined = current ? `${current}${glue}${piece}` : piece;
+    if (joined.length > max) {
+      out.push(current);
+      current = piece;
+    } else {
+      current = joined;
+    }
+  }
+  if (current) {
+    out.push(current);
+  }
+  return out;
+}
+
+function hardCut(text: string, max: number): string[] {
+  const out: string[] = [];
+  for (let start = 0; start < text.length; start += max) {
+    out.push(text.slice(start, start + max));
+  }
+  return out;
+}
+
+function byWords(text: string, max: number): string[] {
+  return pack(text.split(/\s+/).filter(Boolean), max, " ", (word) => hardCut(word, max));
+}
+
+function bySentences(text: string, max: number): string[] {
+  const sentences = text.match(/[^.!?…]+(?:[.!?…]+["'”’)\]]*|$)/g) ?? [text];
+  return pack(
+    sentences.map((sentence) => sentence.trim()).filter(Boolean),
+    max,
+    " ",
+    (sentence) => byWords(sentence, max),
+  );
+}
+
+// A passage in the pieces the engine takes: whole paragraphs where they fit,
+// else whole sentences, else whole words. Never an empty piece.
+export function splitForSpeech(text: string, max = MAX_CHUNK): string[] {
+  const paragraphs = text
+    .split(/\n+/)
+    .map((paragraph) => paragraph.replace(/\s+/g, " ").trim())
+    .filter(Boolean);
+  return pack(paragraphs, max, "\n", (paragraph) => bySentences(paragraph, max));
+}
+
+function clamp(value: number | undefined, min: number, max: number): number | undefined {
+  return typeof value === "number" && Number.isFinite(value) ? Math.min(max, Math.max(min, value)) : undefined;
+}
+
+// What the engine is asked for: nothing the engine would refuse.
+export function speakOptions(options: NativeSpeakOptions = {}): Omit<Parameters<SpeechPlugin["speak"]>[0], "chunks"> {
+  const out: Omit<Parameters<SpeechPlugin["speak"]>[0], "chunks"> = {};
+  const voice = typeof options.voice === "string" ? options.voice.trim() : "";
+  if (voice) out.voice = voice;
+  const rate = clamp(options.rate, 0.25, 4);
+  if (rate !== undefined) out.rate = rate;
+  const pitch = clamp(options.pitch, 0.25, 4);
+  if (pitch !== undefined) out.pitch = pitch;
+  const volume = clamp(options.volume, 0, 1);
+  if (volume !== undefined) out.volume = volume;
+  return out;
+}
+
+const LANGUAGE_NAMES = (() => {
+  try {
+    return new Intl.DisplayNames(["en"], { type: "language" });
+  } catch {
+    return null;
+  }
+})();
+
+// "en-us-x-iob-local" in en-US reads "English (United States), iob". Google's
+// voices are named for their locale and a short variant; other engines
+// name them freely, and those names are shown as they are.
+export function voiceLabel(voice: SpeechPluginVoice): string {
+  let language = voice.language;
+  try {
+    language = LANGUAGE_NAMES?.of(voice.language) ?? voice.language;
+  } catch {
+    // An engine's own tag the browser cannot name.
+  }
+  const google = /^[a-z]{2,3}-[a-z]{2,3}-x-([a-z0-9]+)(?:#[^-]+)?-(?:local|network)$/i.exec(voice.id);
+  const variant = google ? google[1] : voice.id;
+  return `${language}, ${variant}${voice.local ? "" : " (online)"}`;
+}
+
+export function createNativeSpeech(plugin: SpeechPlugin): NativeSpeech {
+  return {
+    async speak(text, options) {
+      const chunks = splitForSpeech(String(text ?? ""));
+      if (!chunks.length) {
+        return "done";
+      }
+      try {
+        const { finished } = await plugin.speak({ chunks, ...speakOptions(options) });
+        return finished ? "done" : "stopped";
+      } catch (error) {
+        throw new Error(reason(error, "This phone's voice could not read that passage."));
+      }
+    },
+    async stop() {
+      await plugin.stop().catch(() => {});
+    },
+    async voices() {
+      const answer = await plugin.voices().catch(() => ({ voices: [] as SpeechPluginVoice[] }));
+      const seen = new Set<string>();
+      const voices: NativeSpeechVoice[] = [];
+      for (const voice of answer.voices ?? []) {
+        const id = String(voice?.id ?? "").trim();
+        if (!id || seen.has(id)) continue;
+        seen.add(id);
+        const clean = { id, language: String(voice.language ?? ""), local: Boolean(voice.local) };
+        voices.push({ ...clean, name: voiceLabel(clean) });
+      }
+      // The voices that work offline first, then by name.
+      return voices.sort((a, b) => Number(b.local) - Number(a.local) || a.name.localeCompare(b.name));
+    },
+  };
+}
+
+// Offers the voice to the page only when the phone has a working engine: a
+// read-aloud switch that then said nothing would be worse than none.
+// Resolves true once installed.
+export async function installNativeSpeech(
+  plugin: SpeechPlugin,
+  target: { odmSpeech?: NativeSpeech; dispatchEvent(event: Event): boolean },
+): Promise<boolean> {
+  const answer = await plugin.available().catch(() => ({ available: false }));
+  if (!answer.available) {
+    return false;
+  }
+  target.odmSpeech = createNativeSpeech(plugin);
+  target.dispatchEvent(new Event(SPEECH_READY_EVENT));
+  return true;
+}
