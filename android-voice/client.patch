+    assert.ok(chunk.trim().length > 0);
+  }
+  // Nothing lost: the same words in the same order.
+  const words = (text: string) => text.split(/\s+/).filter(Boolean);
+  assert.deepEqual(words(chunks.join(" ")), words(`${paragraph} ${paragraph} ${paragraph}`));
