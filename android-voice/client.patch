From f333c366bb41e7466ad0f4df0744fd2367a53788 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 20:07:18 +0800
Subject: [PATCH 1/3] Protected media: drop the old source while the new one is
 fetched

A sound given a protected address (narration under /generated-audio/,
fetched with the player's token) kept its previous source until the
fetched copy arrived. The narration player calls play() straight after
setting src, so Read aloud replayed the previous passage, and when the
new copy landed the load it started paused the element: nothing played,
while the page still believed it was playing and queued every later
passage behind it. A browser drops the old source the moment src is
set; forgetSource() does the same, so play() waits for the copy and
starts it when it arrives. Reproduced and checked in Chromium.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BsPQjebYqr1zAAhxWA3F3b
---
 src/renderer/game/runtime.ts | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/src/renderer/game/runtime.ts b/src/renderer/game/runtime.ts
index 47b8d0a..e809928 100644
--- a/src/renderer/game/runtime.ts
+++ b/src/renderer/game/runtime.ts
@@ -252,6 +252,19 @@ function resolveMedia(
   return null;
 }
 
+// A sound or video given a protected address keeps its old source until the
+// fetched copy arrives, and a page that calls play() straight after setting
+// src (the narration player does) would replay the old one: then the new
+// copy lands, the load it starts pauses the element and nothing plays again,
+// while the page still believes it is playing. A browser drops the old
+// source the moment src is set; this does the same, so play() waits for the
+// copy and starts it when it arrives.
+function forgetSource(element: HTMLMediaElement): void {
+  if (!element.hasAttribute("src") && !element.currentSrc) return;
+  element.removeAttribute("src");
+  element.load();
+}
+
 // new Audio(url), new Image() and element.src = "/..." never touch an
 // attribute the observer would see before the load starts, so the src
 // setters are wrapped: a public path is redirected at once, a protected
@@ -300,7 +313,11 @@ function patchMediaSetters(): void {
             if (this.getAttribute("data-odm-src") === raw) reportRefused(this);
           },
         );
-        if (direct) nativeSet.call(this, direct);
+        if (direct) {
+          nativeSet.call(this, direct);
+        } else if (this instanceof HTMLMediaElement) {
+          forgetSource(this);
+        }
       },
     });
   }
